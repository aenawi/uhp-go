bin/
*.log
.env

# Output of `make conformance-gate`. Evidence of one run on one machine, not a
# record: docs/conformance.md is where a score is written down.
conformance-report.json

# Output of `make capture-claude`. Same reason: the lines worth keeping are the
# ones lifted into the fixtures in cli_test.go, not the whole run.
claude-capture.jsonl

# `probe-claude-delivery.py` imports its sibling MCP server, and importing a
# Python module compiles it.
scripts/__pycache__/

# A task database, and the two files SQLite keeps beside one. `UHP_DB=./uhp.db`
# or a workspace pointed at the checkout puts one here, and it holds every
# prompt a client sent and every answer a harness gave — a committed one
# publishes conversations.
*.db
*.db-wal
*.db-shm

# Claude Code: share project settings, keep personal overrides local.
.claude/settings.local.json
.claude/*.local.json

# Agent scratch space — working notes, never published.
.scratch/

# Local handoff artifact, not part of the project.
START-HERE.md
